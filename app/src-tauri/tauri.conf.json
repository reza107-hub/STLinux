{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "STLinux",
  "version": "0.1.0",
  "identifier": "com.stlinux.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "STLinux",
        "width": 1280,
        "height": 820,
        "minWidth": 600,
        "minHeight": 518,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Git client for Linux",
    "linux": {
      "deb": {
        "depends": [
          "git",
          "openssh-client"
        ]
      }
    }
  }
}